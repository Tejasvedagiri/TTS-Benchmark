# Copy to .env and fill in. Environment variables of the same name win.

# The LLM that labels the scripts and writes each engine's version: any OpenAI-compatible
# server. LM Studio's default address:
LLM_BASE_URL=http://localhost:1234/v1
# The model name as the server knows it (LM Studio: `lms ls`). A capable 20-30B model works well.
LLM_MODEL=
# For hosted APIs only.
LLM_API_KEY=
# 1 = append /no_think to every prompt (Qwen3-style thinking models).
LLM_NO_THINK=

# Where model weights go (default ~/.cache/huggingface). Every model together is ~300 GB.
HF_HOME=
# For gated models (accept each model's licence on Hugging Face first).
HF_TOKEN=
